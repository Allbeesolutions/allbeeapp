{
  "name": "allbee-app",
  "private": true,
  "packageManager": "npm@10",
  "version": "1.0.1",
  "type": "module",
  "description": "ALLBEE \u2014 internal business management app for ALLBEE SOLUTIONS (Haji & Alim)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/test-lockdown-e2e.mjs",
    "test:ui": "node scripts/ui/verify.mjs --full && node scripts/ui/verify.mjs --interactions",
    "test:bundle": "node scripts/release/check-bundle-budget.mjs",
    "certify": "npm test -- --run && npm run test:edge-auth && npm run build && npm run test:bundle",
    "test:edge-auth": "node scripts/security/check-edge-auth.mjs",
    "test:rpc-surface": "node scripts/audit-rpc-surface.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "vite": "^5.4.8",
    "vitest": "^3.2.4"
  }
}
