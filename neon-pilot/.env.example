# Public staging endpoints only; never a SQL connection string, API key or service role.
# Staging Neon Auth: Neon console > branch > Auth > Auth URL
VITE_NEON_AUTH_URL=https://YOUR-STAGING-AUTH-HOST.neon.build/allbee/auth
# Staging Neon Data API: Neon console > branch > Data API > URL
VITE_NEON_DATA_API_URL=https://YOUR-STAGING-DATA-HOST.neon.build/allbee/rest/v1
VITE_NEON_STAGING_ONLY=true
