# Copy this file to ".env" and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
# After editing .env, restart the dev server.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Enable only after the AllBee database migration and RLS are verified.
# Disabled by default to prevent consent prompts when the backend is unavailable.
VITE_CUSTOMER_ANALYTICS_ENABLED=false
